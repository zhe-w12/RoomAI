MODEL_BASE_URL=https://aiping.cn/api/v1
MODEL_API_KEY=
MODEL_NAME=GLM-5.3-Flash
AVAILABLE_MODELS=GLM-5.3-Flash
MODEL_TIMEOUT_SECONDS=45
TAVILY_API_KEY=
TAVILY_TIMEOUT_SECONDS=15
IDLE_TRIGGER_SECONDS=60
IDLE_TRIGGER_MIN_MESSAGES=3
FALLBACK_TRIGGER_MESSAGES=20
# 可用 MODEL_PRICES 按模型分别填写每百万 Token 的人民币价格；未配置时只统计 Token。
MODEL_PRICES={}
MODEL_INPUT_PRICE_PER_MILLION=0
MODEL_OUTPUT_PRICE_PER_MILLION=0
# 可按项目需要调整评估维度，必须是 JSON 数组，每项包含 key、label、guidance。
EVALUATION_DIMENSIONS='[{"key":"feasibility","label":"技术可行性","guidance":"现有技术与团队能力能否实现"},{"key":"people_cost","label":"人力成本","guidance":"需要多少人力与资源投入"},{"key":"timeline","label":"时间周期","guidance":"多久能交付首个可用版本"},{"key":"risk","label":"风险","guidance":"关键不确定性与潜在风险"},{"key":"innovation","label":"创新性","guidance":"相对已有方案的新颖之处"},{"key":"team_fit","label":"团队匹配度","guidance":"与团队技能和资源的匹配程度"}]'
DATABASE_PATH=backend/data/roomai.sqlite3
LANGGRAPH_CHECKPOINT_PATH=backend/data/roomai-checkpoints.sqlite3
UPLOAD_DIR=backend/uploads
DOCUMENT_DIR=backend/documents
FRONTEND_ORIGIN=http://localhost:5173
ROOM_RETENTION_DAYS=30
ROOM_CLEANUP_WARNING_DAYS=3
ROOM_CLEANUP_INTERVAL_SECONDS=3600
